---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { getResources, getNotes, sitePath, resourcePath, resourceGuideLabel, repoUrl } from '../lib/content';
import { roleLabels, deliveryLabels } from '../lib/resource-taxonomy';
import siteConfig from '../../site.config.json';
interface Props { title: string; description?: string; active?: 'home' | 'guides' | 'topics' | 'resources' | 'changelog' | 'contributing'; }
const { title, description = siteConfig.description, active = 'home' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const resources = await getResources();
const notes = await getNotes();
const navigation = [
  { id: 'home', label: '首页', href: sitePath() },
  { id: 'guides', label: '资源导览', href: sitePath('notes/') },
  { id: 'topics', label: '主题导航', href: sitePath('topics/') },
  { id: 'resources', label: '资源库', href: sitePath('resources/') },
  { id: 'changelog', label: '更新日志', href: sitePath('changelog/') },
];
const searchItems = [
  {title:'资源导览', description:'从领域划分了解基础设施，通过方案全景浏览开源框架、运行平台与云厂商产品。', category:'站点导航', url:sitePath('notes/'), keywords:'领域 概览 全景 方案 总览 导览 guides landscape'},
  {title:'主题导航', description:'按七个主要主题浏览 Agent 基础设施项目、平台与参考资料。', category:'站点导航', url:sitePath('topics/'), keywords:'主题 导航 项目 topics'},
  {title:'关联基础设施', description:'了解 Agent 与推理、模型服务基础设施的连接。', category:'站点导航', url:sitePath('topics/#related-infrastructure'), keywords:'模型 推理 serving 关联'},
  {title:'更新日志', description:'查看最近新增的资源、内容更新与站点改进。', category:'站点导航', url:sitePath('changelog/'), keywords:'更新 最近更新 新增 changelog updates'},
  ...resources.map(r => ({title:r.name, description:r.description, category:r.topicZhTitle, url:resourcePath(r), keywords:[r.topicTitle, r.type, r.maintainer, r.form, ...r.aliases, ...r.keywords, r.role && roleLabels[r.role], r.delivery && deliveryLabels[r.delivery]].filter(Boolean).join(' ')})),
  ...notes.map(n => ({title:n.title, description:n.description, category:resourceGuideLabel(n.slug), url:sitePath(`notes/${n.slug}/`), keywords:'资源导览 方案总览 guide'})),
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f2" />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · ${siteConfig.title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(sitePath('social-card.png'), Astro.site)} />
    <meta property="og:image:alt" content="Agentic Infra · 发现项目，了解方案" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} 更新订阅`} href={sitePath('feed.xml')} />
    <title>{title} · {siteConfig.title}</title>
    <script is:inline>
      try { const saved = localStorage.getItem('agentic-infra-theme'); document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={sitePath()} aria-label="Agentic Infra 首页"><span class="brand-mark"><Icon name="stack" size={25} /></span><span>Agentic<span class="brand-light"> Infra</span><small>AN OPEN FIELD GUIDE</small></span></a>
        <nav class="desktop-nav" aria-label="主导航">
          {navigation.map((item) => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <button class="search-trigger" type="button" data-search-open aria-label="搜索资源与导览"><Icon name="search" size={17}/><span>搜索</span><kbd>⌘ K</kbd></button>
          <button class="icon-button theme-toggle" type="button" aria-label="切换深色模式"><span class="sun-icon"><Icon name="sun" size={19}/></span><span class="moon-icon"><Icon name="moon" size={19}/></span></button>
          <a class="github-link" href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label="访问 GitHub 仓库（新窗口）"><Icon name="github" size={20}/></a>
        </div>
      </div>
      <nav class="mobile-nav" aria-label="移动端主导航">
        {navigation.map((item) => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </header>
    <slot />
    <footer class="site-footer"><div class="footer-inner"><div><a class="footer-brand" href={sitePath()}>Agentic Infra<span> / </span>发现项目，了解方案。</a><p>汇集 Agent 基础设施资源，提供中文项目介绍与官方资料入口。</p></div><div class="footer-links"><a href={sitePath('changelog/')}>更新日志</a><a href={sitePath('feed.xml')}>RSS 订阅</a><a href={sitePath('contributing/')}>参与贡献</a><a href={`${repoUrl}/blob/main/LICENSE`}>CC BY 4.0</a><a href={repoUrl}>GitHub ↗</a></div></div></footer>
    <dialog id="search-dialog" aria-labelledby="search-title">
      <div class="search-dialog-head"><Icon name="search" size={21}/><label id="search-title" class="sr-only" for="global-search">搜索资源与导览</label><input id="global-search" type="search" placeholder="搜索项目、主题或方案…" autocomplete="off"/><button class="icon-button" type="button" data-search-close aria-label="关闭搜索"><Icon name="close" size={19}/></button></div>
      <div class="search-dialog-meta"><span id="search-status" role="status">输入关键词，探索整个知识库</span><kbd>ESC 关闭</kbd></div>
      <div id="search-results" class="search-results"></div>
    </dialog>
    <script id="search-data" type="application/json" set:html={JSON.stringify(searchItems).replace(/</g, '\\u003c')} />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>

<style>
  @media (min-width: 901px) and (max-width: 1150px) {
    .header-inner { gap: 18px; }
    .desktop-nav { gap: 16px; font-size: 13px; }
    .search-trigger kbd { display: none; }
  }
  @media (max-width: 900px) {
    .mobile-nav { gap: 23px; overflow-x: auto; scrollbar-width: thin; overscroll-behavior-x: contain; }
    .mobile-nav a { flex-shrink: 0; padding-block: 3px; }
  }
  @media (max-width: 380px) {
    .mobile-nav { gap: 14px; padding-inline: 16px; }
  }
</style>
