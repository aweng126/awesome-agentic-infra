---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getNotes, resourceGuideLabel, sitePath } from '../../lib/content';

const notes = await getNotes();
const guides = [...notes].sort((left, right) => Number(right.slug === 'agentic-infra-overview') - Number(left.slug === 'agentic-infra-overview'));
---

<SiteLayout title="资源导览" description="了解 Agentic Infra 的分类范围，浏览开源项目、运行平台与云厂商方案总览。" active="guides">
  <main id="main-content" class="notes-page">
    <header class="guides-header">
      <p class="eyebrow">RESOURCE GUIDES</p>
      <h1>资源导览<span class="accent-dot">。</span></h1>
      <p>了解主题范围和方案分类，找到适合继续查阅的项目与官方资料。</p>
    </header>
    <section aria-label="领域导览与方案总览">
      <ul class="guide-list">
        {guides.map((guide) => <li>
          <p class="guide-role">{resourceGuideLabel(guide.slug)}</p>
          <h2><a href={sitePath(`notes/${guide.slug}/`)}>{guide.title}<span aria-hidden="true">→</span></a></h2>
          <p class="guide-description">{guide.description}</p>
        </li>)}
      </ul>
    </section>
    <a class="guides-return" href={sitePath('resources/')}>搜索与筛选全部资源 <span aria-hidden="true">→</span></a>
  </main>
</SiteLayout>

<style>
  .notes-page { max-width: 900px; margin: 0 auto; padding: 64px 36px 80px; }
  .guides-header { margin-bottom: 36px; }
  .guides-header .eyebrow { margin-bottom: 16px; }
  h1 { font-size: clamp(30px, 4vw, 42px); letter-spacing: -.045em; line-height: 1.4; }
  .guides-header > p:last-child { margin-top: 18px; color: var(--muted); font-size: 14px; line-height: 1.9; }
  .guide-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .guide-list li { padding: 26px 0; border-bottom: 1px solid var(--line); }
  .guide-role { margin-bottom: 9px; color: var(--muted); font-size: 11px; }
  .guide-list h2 { font-size: 20px; font-weight: 550; line-height: 1.65; }
  .guide-list h2 a { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .guide-list h2 a:hover { color: var(--accent); }
  .guide-description { margin-top: 10px; color: var(--muted); font-size: 13px; line-height: 1.9; }
  .guides-return { display: inline-flex; align-items: center; gap: 12px; margin-top: 28px; color: var(--accent); font-size: 12px; }
  @media (max-width: 600px) { .notes-page { padding: 40px 20px 60px; } .guide-list h2 { font-size: 18px; } }
</style>
