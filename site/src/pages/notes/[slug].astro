---
import SiteLayout from '../../layouts/SiteLayout.astro';
import DocumentView from '../../components/DocumentView.astro';
import { getNotes, sitePath } from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, index) => ({
    params: { slug: note.slug },
    props: {
      note,
      previous: index > 0 ? notes[index - 1] : undefined,
      next: index < notes.length - 1 ? notes[index + 1] : undefined,
    },
  }));
}

const { note, previous, next } = Astro.props;
---

<SiteLayout title={note.title} description={note.description} active="notes">
  <DocumentView
    title={note.title}
    kind="note"
    slug={note.slug}
    html={note.html}
    headings={note.headings}
    updated={note.updated}
    sourcePath={note.sourcePath}
    readingMinutes={note.readingMinutes}
    previous={previous ? { href: sitePath(`notes/${previous.slug}/`), title: previous.title } : { href: sitePath('notes/'), title: '全部研究笔记', label: '返回索引' }}
    next={next ? { href: sitePath(`notes/${next.slug}/`), title: next.title } : { href: sitePath('resources/'), title: '探索八个基础设施主题', label: '延伸阅读' }}
  />
</SiteLayout>
