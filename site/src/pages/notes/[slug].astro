---
import SiteLayout from '../../layouts/SiteLayout.astro';
import DocumentView from '../../components/DocumentView.astro';
import { getNotes, sitePath } from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const resourceLink = note.slug === 'agent-runtime-landscape'
  ? { href: sitePath('topics/runtime-and-orchestration/'), title: '运行时与编排', label: '查看相关主题' }
  : { href: sitePath('resources/'), title: '搜索与筛选全部资源', label: '前往资源库' };
---

<SiteLayout title={note.title} description={note.description} active="topics">
  <DocumentView
    title={note.title}
    kind="note"
    slug={note.slug}
    html={note.html}
    headings={note.headings}
    sourcePath={note.sourcePath}
    previous={{ href: sitePath('notes/'), title: '资源导览', label: '返回导览' }}
    next={resourceLink}
  />
</SiteLayout>
