---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import ResourceMeta from '../../components/ResourceMeta.astro';
import { getTopics, getResources, groupTopics, resourcePath, sitePath } from '../../lib/content';
import { roleLabels, deliveryLabels } from '../../lib/resource-taxonomy';
const topics = await getTopics();
const resources = await getResources();
const topicGroups = groupTopics(topics);
const relatedSlugs = new Set(topicGroups[1].topics.map((topic) => topic.slug));
const types = [{id:'all',label:'全部类型'},{id:'project',label:'项目与平台'},{id:'paper',label:'论文'},{id:'spec',label:'协议规范'},{id:'article',label:'文章与文档'}];
const typeLabel = Object.fromEntries(types.map(type=>[type.id,type.label]));
const roles = Object.entries(roleLabels).filter(([role]) => resources.some((resource) => resource.role === role));
const deliveries = Object.entries(deliveryLabels).filter(([delivery]) => resources.some((resource) => resource.delivery === delivery));
---
<SiteLayout title="资源库" description="按主题、资源类型和关键词，查找 Agent 基础设施项目、论文与技术资料。" active="resources">
  <main id="main-content" class="container explorer" data-resource-explorer>
    <div class="page-heading"><p class="eyebrow">THE RESOURCE LIBRARY</p><h1>查找基础设施资料<span class="accent-dot">。</span></h1><p>按主题、类型或关键词筛选，了解项目与方案，继续探索官方资料。</p></div>
    <div class="explorer-search"><Icon name="search" size={22}/><label class="sr-only" for="resource-search">搜索资源</label><input id="resource-search" type="search" autocomplete="off" placeholder="搜索名称、技术机制或关键词，如 sandbox、记忆、MCP…"/><span>已收录 {resources.length} 条</span></div>
    <div class="explorer-layout">
      <aside class="filter-sidebar" aria-label="按主题筛选">
        <details class="filter-panel" open>
        <summary>筛选资源 <span id="filter-summary">全部资源</span><Icon name="chevron" size={14}/></summary>
        <div class="filter-panel-content">
        <h2>筛选范围</h2>
        <p class="filter-count-hint" id="topic-count-hint">数量随搜索词和筛选条件更新</p>
        <div class="topic-filters" aria-describedby="topic-count-hint">
          <button type="button" data-topic="all" aria-pressed="true">全部资源<span data-topic-count>{resources.length}</span></button>
        </div>
        {topicGroups.map((group) => <div class="topic-filter-group" data-topic-group={group.id} role="group" aria-labelledby={`filters-${group.id}`}>
          <h3 id={`filters-${group.id}`}>{group.title}</h3>
          <div class="topic-filters" aria-describedby="topic-count-hint">
            {group.topics.map(topic => <button type="button" data-topic={topic.slug} aria-pressed="false">{topic.zhTitle}<span data-topic-count>{topic.entries.length}</span></button>)}
          </div>
        </div>)}
        <div class="product-filters">
          <label for="resource-role">资源角色</label>
          <select id="resource-role"><option value="all">全部角色</option>{roles.map(([value, label]) => <option value={value}>{label}</option>)}</select>
          <label for="resource-delivery">交付方式</label>
          <select id="resource-delivery"><option value="all">全部交付方式</option>{deliveries.map(([value, label]) => <option value={value}>{label}</option>)}</select>
        </div>
        </div>
        </details>
        <div class="sidebar-note">
          <Icon name="book" size={20}/>
          <p>不确定从哪里开始？</p>
          <a href={sitePath('notes/agentic-infra-overview/')}>查看领域导览 →</a>
        </div>
      </aside>
      <section class="resource-results" aria-label="资源列表">
        <div class="type-filters" aria-label="按资料类型筛选">
          {types.map(type => <button type="button" data-type={type.id} aria-pressed={type.id === 'all' ? 'true' : 'false'}><span>{type.label}</span><span data-type-count>{type.id === 'all' ? resources.length : resources.filter((resource) => resource.type === type.id).length}</span></button>)}
        </div>
        <div id="active-filters" class="active-filters" aria-label="当前筛选条件" hidden></div>
        <div class="results-meta">
          <p id="resource-count" role="status">共 {resources.length} 条资源</p>
          <button class="reset-filters" type="button" id="reset-filters" hidden>清除筛选</button>
        </div>
        <div class="resource-list">
          {resources.map(resource => (
              <article class="resource-card" id={resource.id} data-id={resource.id} data-title={resource.name} data-topic={resource.topicSlug} data-type={resource.type} data-role={resource.role} data-delivery={resource.delivery} data-search={`${resource.name} ${resource.aliases.join(' ')} ${resource.keywords.join(' ')} ${resource.description} ${resource.topicTitle} ${resource.topicZhTitle} ${resource.maintainer ?? ''} ${resource.form ?? ''} ${resource.role ? roleLabels[resource.role] : ''} ${resource.delivery ? deliveryLabels[resource.delivery] : ''}`}>
                <div class="resource-card-heading">
                  <h2>{resource.hasProfile ? <a class="resource-profile-title" href={resourcePath(resource)} data-resource-profile-link>{resource.name}</a> : resource.name}</h2>
                  <span class="resource-type">{typeLabel[resource.type]}</span>
                </div>
                <ResourceMeta resource={resource}/>
                <p>{resource.description}</p>
                <div class="resource-links">
                  <ResourceLinks resource={resource}/>
                  <a class="resource-topic-link" href={sitePath(`topics/${resource.topicSlug}/`)}>
                    {relatedSlugs.has(resource.topicSlug) ? '关联资料' : '所属主题'}：{resource.topicZhTitle}<Icon name="arrow" size={13}/>
                  </a>
                </div>
              </article>
          ))}
        </div>
        <div id="no-results" class="empty-state" hidden>
          <Icon name="search" size={34}/>
          <h2>还没有找到匹配的资源</h2>
          <p>试试更短的关键词，或移除部分筛选条件。</p>
          <button class="button outline" type="button" data-reset-all>查看全部资源</button>
        </div>
      </section>
    </div>
    <noscript><p class="noscript-note">所有资源已列在本页。启用 JavaScript 后可使用搜索与筛选；也可以使用浏览器的页面查找。</p></noscript>
  </main>
  <script>import '../../scripts/explorer';</script>
</SiteLayout>

<style>
  .resource-profile-title:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 5px; }
  .filter-panel > summary { display: none; }
  .product-filters { display: grid; gap: 9px; margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--line); }
  .product-filters label { color: var(--muted); font-size: 11px; }
  .product-filters label:not(:first-child) { margin-top: 5px; }
  .product-filters select { width: 100%; min-width: 0; padding: 8px 9px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--text); font: inherit; font-size: 11px; }
  .type-filters button { display: inline-flex; align-items: center; gap: 7px; }
  [data-type-count] { opacity: .65; font: 9px var(--font-mono); }
  .topic-filter-group { margin-top: 22px; }
  .topic-filter-group + .topic-filter-group { padding-top: 18px; border-top: 1px solid var(--line); }
  .topic-filter-group h3 { margin: 0 11px 9px; font-size: 11px; font-weight: 500; letter-spacing: .05em; color: var(--muted); }
  @media (min-width: 761px) { .filter-panel:not([open]) > .filter-panel-content { display: block; } }
  @media (max-width: 760px) {
    .filter-panel { border: 1px solid var(--line); border-radius: 8px; }
    .filter-panel > summary { display: flex; align-items: center; gap: 10px; padding: 13px 14px; cursor: pointer; font-size: 12px; }
    .filter-panel > summary span { flex: 1; text-align: right; color: var(--muted); font-size: 10px; }
    .filter-panel[open] > summary { border-bottom: 1px solid var(--line); }
    .filter-panel-content { padding: 16px 14px; }
    .filter-panel-content > .topic-filters { margin-bottom: 0; padding-bottom: 4px; }
    .topic-filter-group { margin-top: 12px; }
    .topic-filter-group + .topic-filter-group { padding-top: 0; border-top: 0; }
    .topic-filter-group h3 { margin: 0 0 7px; font-size: 10px; }
    .topic-filter-group .topic-filters { margin-bottom: 0; padding-bottom: 8px; }
    .filter-sidebar { margin-bottom: 18px; }
    .product-filters { margin-top: 15px; }
  }
</style>
