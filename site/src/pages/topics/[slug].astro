---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import ResourceMeta from '../../components/ResourceMeta.astro';
import { getTopics, groupTopics, sitePath, resourcePath, repoUrl, topicScopeLabels, type Resource } from '../../lib/content';
import { roleLabels } from '../../lib/resource-taxonomy';

export async function getStaticPaths() {
  return (await getTopics()).map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const topics = await getTopics();
const topicGroups = groupTopics(topics);
const isRelated = topic.scope === 'serving';
const sectionLabel = isRelated ? '关联基础设施' : '主题导航';
const editUrl = `${repoUrl}/edit/main/${topic.sourcePath}`;
const resourceTypes = [
  { type: 'project', title: '项目与平台', id: 'projects--platforms' },
  { type: 'paper', title: '论文', id: 'papers' },
  { type: 'spec', title: '协议规范', id: 'specifications' },
  { type: 'article', title: '文章与文档', id: 'articles--documentation' },
];
const resourceGroups = resourceTypes.map((kind) => {
  const entries = (topic.entries as Resource[]).filter((resource) => resource.type === kind.type);
  const roles = [...new Set(entries.map((resource) => resource.role ?? ''))];
  return { ...kind, entries, groups: roles.map((role) => ({
    role,
    label: role ? roleLabels[role as keyof typeof roleLabels] : '其他资料',
    entries: entries.filter((resource) => (resource.role ?? '') === role),
  })) };
}).filter((kind) => kind.entries.length > 0);
---

<SiteLayout title={`${topic.zhTitle} · ${sectionLabel}`} description={topic.description} active="topics">
  <main id="main-content" class="topic-shell">
    <aside class="topic-sidebar" aria-label="主题导航">
      <details class="topic-menu" open>
        <summary>主题导航 <span aria-hidden="true">⌄</span></summary>
        <nav aria-label="主题导航">
          {topicGroups.map((group) => <div class="topic-nav-group" data-topic-group={group.id}>
          <p class="sidebar-label">{group.title}</p>
          <ol class="topic-navigation">
            {group.topics.map((entry, index) => <li>
              <a href={sitePath(`topics/${entry.slug}/`)} aria-current={entry.slug === topic.slug ? 'page' : undefined}>
                <span class="topic-order" aria-hidden="true">{group.id === 'primary' ? String(index + 1).padStart(2, '0') : '↳'}</span>
                <span>{entry.zhTitle}</span>
              </a>
            </li>)}
          </ol>
          </div>)}
          <a class="sidebar-resource-link" href={sitePath('resources/')}>
            搜索与筛选全部资源 <Icon name="arrow" size={16} />
          </a>
        </nav>
      </details>
    </aside>

    <div class="topic-content">
      <nav class="breadcrumbs" aria-label="面包屑">
        <a href={sitePath()}>首页</a><span aria-hidden="true">/</span>
        <a href={`${sitePath()}#${isRelated ? 'related-infrastructure' : 'topics'}`}>{sectionLabel}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{topic.zhTitle}</span>
      </nav>
      <header class="topic-header">
        <p class="eyebrow">{topicScopeLabels[topic.scope]}</p>
        <h1>{topic.zhTitle}</h1>
        <p class="topic-subtitle">{topic.title}</p>
      </header>

      <section class="topic-section topic-intro" aria-labelledby="topic-guide">
        <h2 id="topic-guide">{isRelated ? '关联范围' : '主题范围'}</h2>
        <div class="prose" set:html={topic.introHtml} />
      </section>

      <section class="topic-section reference-section" aria-labelledby="reference-materials">
        <div class="section-top"><h2 id="reference-materials">资源清单</h2><span>{topic.entries.length} 条资料</span></div>
        <div class="reference-list">
          {resourceGroups.map((kind) => <section class="resource-kind" aria-labelledby={kind.id}>
            <h3 id={kind.id}>{kind.title}</h3>
            {kind.groups.map((group) => <div class="resource-role-group">
              {kind.groups.length > 1 && <h4 class="resource-role-title">{group.label}</h4>}
              <ul>
                {group.entries.map((resource) => <li id={resource.anchor} class="topic-resource-entry">
                  <p class="topic-resource-title">{resource.hasProfile ? <a href={resourcePath(resource)}>{resource.name}</a> : resource.name}</p>
                  <ResourceMeta resource={resource}/>
                  <p class="topic-resource-description">{resource.description}</p>
                  <ResourceLinks resource={resource}/>
                </li>)}
              </ul>
            </div>)}
          </section>)}
        </div>
      </section>
      {topic.learningNotes.length > 0 && <section class="topic-section overview-section" aria-labelledby="solution-overviews">
        <h2 id="solution-overviews">方案总览</h2>
        <ul class="solution-overviews">
          {topic.learningNotes.map((note) => <li>
            <h3><a href={sitePath(`notes/${note.slug}/`)}>{note.title}<Icon name="arrow" size={14} /></a></h3>
            <p>{note.description}</p>
          </li>)}
        </ul>
      </section>}
      <footer class="topic-footer"><a href={editUrl} target="_blank" rel="noopener noreferrer">在 GitHub 改进本页 <Icon name="external" size={14} /></a></footer>
    </div>
  </main>
</SiteLayout>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.topic-menu');
  const desktop = window.matchMedia('(min-width: 960px)');
  const syncMenu = () => { if (menu) menu.open = desktop.matches; };
  syncMenu();
  desktop.addEventListener('change', syncMenu);
</script>

<style>
  .topic-shell { display: grid; grid-template-columns: 220px minmax(0, 820px); gap: 66px; max-width: 1210px; margin: 0 auto; padding: 42px 36px 80px; align-items: start; }
  .topic-sidebar { min-width: 0; position: sticky; top: 110px; }
  .topic-menu summary { display: none; }
  .sidebar-label { font-size: 11px; color: var(--muted); letter-spacing: .06em; margin: 0 12px 16px; }
  .topic-nav-group + .topic-nav-group { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--line); }
  .topic-navigation { list-style: none; padding: 0; margin: 0; }
  .topic-navigation a { display: flex; align-items: baseline; gap: 12px; padding: 12px; font-size: 12px; line-height: 1.6; color: var(--muted); border-radius: 6px; margin: 3px 0; }
  .topic-navigation a:hover { color: var(--accent); background: var(--surface-alt); }
  .topic-navigation a[aria-current] { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .topic-order { font: 10px/1.6 var(--font-mono); opacity: .6; }
  .sidebar-resource-link { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 27px 12px 0; padding-top: 22px; border-top: 1px solid var(--line); font-size: 11px; color: var(--accent); }
  .topic-content { min-width: 0; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 9px; font-size: 11px; line-height: 1.7; color: var(--muted); margin-bottom: 36px; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs [aria-current] { color: var(--text); }
  .topic-header { padding-bottom: 29px; border-bottom: 1px solid var(--line); }
  .topic-header .eyebrow { margin-bottom: 14px; }
  h1 { font-size: clamp(29px, 3.2vw, 40px); line-height: 1.4; letter-spacing: -.045em; }
  .topic-subtitle { margin-top: 10px; font-size: 15px; color: var(--muted); }
  .topic-section { margin-top: 36px; }
  .topic-section h2 { font-size: 19px; line-height: 1.5; scroll-margin-top: 140px; }
  .topic-intro > h2 { margin-bottom: 17px; }
  .section-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 18px; }
  .section-top > span { font-size: 11px; color: var(--muted); }
  .overview-section { padding-top: 24px; border-top: 1px solid var(--line); }
  .overview-section > h2 { font-size: 14px; color: var(--muted); font-weight: 500; }
  .solution-overviews { list-style: none; padding: 0; margin: 15px 0 0; }
  .solution-overviews > li + li { margin-top: 18px; }
  .solution-overviews h3 { font-size: 15px; line-height: 1.7; font-weight: 550; }
  .solution-overviews h3 a { display: inline-flex; align-items: center; gap: 9px; }
  .solution-overviews h3 a:hover { color: var(--accent); }
  .solution-overviews p { margin-top: 6px; color: var(--muted); font-size: 12px; line-height: 1.85; }
  .reference-section { margin-top: 44px; }
  .reference-list { font-size: 13px; line-height: 1.95; }
  .resource-kind + .resource-kind { margin-top: 34px; }
  .resource-kind > h3 { font-size: 15px; font-weight: 600; margin: 0 0 15px; scroll-margin-top: 140px; }
  .resource-role-title { color: var(--muted); font-size: 12px; font-weight: 500; margin: 20px 0 0; }
  .resource-role-group ul { list-style: none; padding: 0; margin: 0; }
  .topic-resource-entry { padding: 18px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 140px; }
  .topic-resource-entry:target { background: var(--accent-soft); box-shadow: 12px 0 var(--accent-soft), -12px 0 var(--accent-soft); }
  .topic-resource-title { font-size: 15px; font-weight: 550; line-height: 1.65; overflow-wrap: anywhere; }
  .topic-resource-title a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .topic-resource-description { color: var(--muted); margin: 8px 0 10px; }
  .topic-resource-entry :global(.resource-source) { font-size: 11px; }
  .topic-footer { margin-top: 35px; padding-top: 23px; border-top: 1px solid var(--line); font-size: 11px; color: var(--muted); }
  .topic-footer a { display: inline-flex; align-items: center; gap: 6px; }
  .topic-footer a:hover { color: var(--accent); }
  @media (min-width: 960px) { .topic-menu:not([open]) > nav { display: block; } }
  @media (max-width: 1100px) { .topic-shell { gap: 38px; grid-template-columns: 205px minmax(0, 1fr); padding-inline: 28px; } }
  @media (max-width: 959px) { .topic-shell { display: block; max-width: 820px; padding: 24px 26px 60px; } .topic-sidebar { position: static; margin-bottom: 30px; } .topic-menu { border: 1px solid var(--line); border-radius: 8px; } .topic-menu summary { display: flex; justify-content: space-between; padding: 14px 18px; font-size: 12px; color: var(--muted); cursor: pointer; } .topic-menu[open] summary { border-bottom: 1px solid var(--line); } .topic-menu nav { padding: 14px 10px 20px; } .topic-menu .sidebar-label { display: none; } .topic-navigation { display: grid; grid-template-columns: 1fr 1fr; gap: 0 10px; } .sidebar-resource-link { margin-top: 14px; padding-top: 16px; } .breadcrumbs { margin-bottom: 29px; } }
  @media (max-width: 959px) { .topic-menu .topic-nav-group .sidebar-label { display: block; margin-bottom: 8px; } }
  @media (max-width: 560px) { .topic-shell { padding-inline: 20px; } .topic-navigation { display: block; } .topic-header { padding-bottom: 25px; } h1 { font-size: 29px; } .topic-subtitle { font-size: 13px; } .section-top { align-items: baseline; gap: 12px; } .section-top > span { font-size: 10px; } .breadcrumbs { gap: 7px; font-size: 10px; } }
</style>
