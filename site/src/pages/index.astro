---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import InfrastructureMap from '../components/InfrastructureMap.astro';
import { getTopics, getResources, getNotes, sitePath } from '../lib/content';
const topics = await getTopics();
const resources = await getResources();
const notes = await getNotes();
const icons = ['runtime','sandbox','memory','tools','inference','deployment','observability','security'];
---
<SiteLayout title="理解 Agent 背后的基础设施" active="home">
  <main id="main-content">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> A FIELD GUIDE TO AGENTIC INFRASTRUCTURE</p><h1 id="hero-title">理解 Agent 背后的<br/><span>基础设施。</span></h1><p class="hero-description">从运行时到执行环境，从记忆到协作。<br/>梳理值得关注的项目、论文与工程实践，<br class="desktop-break"/>探索智能体如何可靠地运行。</p><div class="hero-buttons"><a class="button primary" href={sitePath('resources/')}>探索资源库 <Icon name="arrow" size={18}/></a><a class="button text-button" href={sitePath('notes/agentic-infra-overview/')}>从概览开始 <Icon name="book" size={18}/></a></div><p class="hero-small">开源共建 <span>·</span> 中文导读 <span>·</span> 一手来源</p></div>
      <InfrastructureMap />
    </section>
    <section class="stats-strip container" aria-label="知识库概况"><div><strong>{String(topics.length).padStart(2,'0')}</strong><span>基础设施主题</span></div><div><strong>{resources.length}</strong><span>精选资源</span></div><div><strong>{String(notes.length).padStart(2,'0')}</strong><span>研究笔记</span></div><div class="stat-statement"><span class="live-dot"></span><span>让散落的资料<br/><b>成为相连的知识。</b></span></div></section>
    <section class="topics-section container" id="topics" aria-labelledby="topics-title"><div class="section-heading"><div><p class="eyebrow">EXPLORE THE LANDSCAPE</p><h2 id="topics-title">八个视角，看见系统全貌<span class="accent-dot">。</span></h2></div><a class="inline-link" href={sitePath('resources/')}>全部资源 <Icon name="arrow" size={17}/></a></div><div class="topic-grid">{topics.map((topic, i) => <a class="topic-card" href={sitePath(`topics/${topic.slug}/`)}><div class="topic-card-top"><span class="topic-icon"><Icon name={icons[i]} size={23}/></span><span class="topic-number">{String(i+1).padStart(2,'0')}</span></div><h3>{topic.zhTitle}</h3><p class="topic-english">{topic.title}</p><p class="topic-description">{topic.description}</p><div class="topic-card-bottom"><span>{topic.entries.length} 条资源</span><Icon name="arrow" size={18}/></div></a>)}</div></section>
    <section class="reading-section container" aria-labelledby="reading-title"><div class="reading-intro"><p class="eyebrow">A GOOD PLACE TO START</p><h2 id="reading-title">从一个问题，<br/>开始深入。</h2><p>沿着问题找到资料，<br/>再把资料串成自己的理解。</p><a class="inline-link" href={sitePath('notes/')}>阅读研究笔记 <Icon name="arrow" size={17}/></a></div><div class="reading-paths"><a href={sitePath('notes/agentic-infra-overview/')}><span class="path-number">01</span><div><h3>Agentic Infra 到底包含什么？</h3><p>从任务执行链路出发，理解组件关系与分类边界。</p><span>概念与架构</span></div><Icon name="external" size={20}/></a><a href={sitePath('topics/runtime-and-orchestration/')}><span class="path-number">02</span><div><h3>一个长任务，如何持续运行？</h3><p>探索执行循环、状态持久化、失败恢复与协作。</p><span>运行时与编排</span></div><Icon name="external" size={20}/></a><a href={sitePath('topics/observability-and-evaluation/')}><span class="path-number">03</span><div><h3>如何判断系统运行得好不好？</h3><p>从执行追踪到任务评估，建立观察系统的方法。</p><span>观测与评估</span></div><Icon name="external" size={20}/></a></div></section>
    <section class="scope-section container" id="scope"><p class="eyebrow">WHAT BELONGS HERE</p><h2>围绕 Agent 运行，保持清晰的边界。</h2><p>我们关注支撑 Agent 执行、协作、状态管理与可靠运行的系统组件及机制。通用数据库、云平台与推理系统，需要说明它们与 Agent 工作负载的具体关系。沿着具体问题阅读资料、理解机制，再通过学习笔记串起不同组件之间的关系。</p></section>
    <section class="contribute-banner container"><span class="topic-icon"><Icon name="stack" size={26}/></span><div><h2>这个领域在生长，知识库也是。</h2><p>分享值得关注的资源，补充实践经验，或修正一处描述。</p></div><a class="button outline" href={sitePath('contributing/')}>一起完善 <Icon name="arrow" size={17}/></a></section>
  </main>
</SiteLayout>
